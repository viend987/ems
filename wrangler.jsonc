{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ems",
  "compatibility_date": "2026-09-01",
  // Worker kecil yang hanya menangani /api/* (proxy upload Imgur untuk Patrol Log).
  // Semua path lain dilayani aset statis tanpa menyentuh Worker.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "ems.viend.my.id", "custom_domain": true }],
  // Workers Builds menjalankan `wrangler preview` untuk branch selain main, dan
  // perintah itu menolak jalan tanpa blok ini. Kosong berarti preview memakai
  // aset, compatibility, dan binding yang sama dengan produksi.
  "previews": {}
}
